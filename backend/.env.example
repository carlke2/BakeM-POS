# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
# Public site URL used in parent welcome SMS/email login links
FRONTEND_URL=http://localhost:5173

# ── Database (Supabase PostgreSQL) ───────────────────────────────────────────
# For a long-running Node backend, prefer SESSION pooler (port 5432) over transaction pooler (6543).
# Supabase Dashboard → Project Settings → Database → Connection string → "Session pooler"
DATABASE_URL="postgresql://USER:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres?pgbouncer=true&connect_timeout=15"
# Direct connection — used by Prisma migrate/db push only
DIRECT_URL="postgresql://USER:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret

# ── Supabase JS client ────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Must be the full service_role JWT from Supabase Dashboard → Settings → API (starts with eyJ, ~200+ chars)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Google OAuth (future) ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Seed defaults ─────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@smartpos.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=System Admin

# ── Fingerprint scanner (local ZKTeco service on enrollment PC) ───────────────
# URL of the machine where the ZK9500 USB scanner is plugged in (reachable from this backend).
# Example: http://203.0.113.50:17890  (enrollment PC public/LAN IP)
FINGERPRINT_SCANNER_URL=http://127.0.0.1:17890

# ── SMTP (password reset emails) ─────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
# Gmail: use your Gmail address as FROM, or a verified alias
MAIL_FROM_ADDRESS=your-email@gmail.com
# ── Kopokopo (M-Pesa STK Push via K2 Connect) ─────────────────────────────────
KOPOKOPO_BASE_URL=https://api.kopokopo.com
KOPOKOPO_CLIENT_ID=your_client_id
KOPOKOPO_CLIENT_SECRET=your_client_secret
KOPOKOPO_API_KEY=your_api_key
KOPOKOPO_TILL_NUMBER=your_till_number
# Public URL Kopokopo calls when payment completes
KOPOKOPO_CALLBACK_URL=https://your-public-host/api/kopokopo/payment/callback
# URL for generic webhook subscriptions (POST /api/kopokopo/subscribe-webhooks)
KOPOKOPO_WEBHOOK_URL=https://your-public-host/api/kopokopo/webhooks

# ── Advanta SMS (optional) ────────────────────────────────────────────────────
ADVANTA_SMS_URL="https://quicksms.advantasms.com/api/services/sendsms/"
ADVANTA_API_KEY=your_api_key
ADVANTA_PARTNER_ID=your_partner_id
ADVANTA_SHORTCODE=your_shortcode_or_sender_id
