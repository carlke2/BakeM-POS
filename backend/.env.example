# ── Slow Rise Co — Bakery POS backend ─────────────────────────────────────────
PORT=5000
FRONTEND_URL=http://localhost:5173

# ── Database (Supabase PostgreSQL) ───────────────────────────────────────────
# For a long-running Node backend, prefer SESSION pooler (port 5432) over transaction pooler (6543).
# Supabase Dashboard → Project Settings → Database → Connection string → "Session pooler"
DATABASE_URL="postgresql://USER:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres?pgbouncer=true&connect_timeout=15"
# Direct connection — used by Prisma migrate/db push only
DIRECT_URL="postgresql://USER:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret

# ── Supabase JS client (menu image uploads) ───────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Must be the full service_role JWT from Supabase Dashboard → Settings → API (starts with eyJ, ~200+ chars)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Seed defaults (Slow Rise Co) ──────────────────────────────────────────────
SEED_OWNER_EMAIL=owner@slowrise.co
SEED_OWNER_PASSWORD=Owner@12345
SEED_OWNER_NAME=Slow Rise Owner

# ── SMTP (optional notifications) ────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME=Slow Rise Co

# ── Safaricom Daraja (M-Pesa STK Push) ────────────────────────────────────────
# sandbox | production
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
# Paybill or the shortcode registered on Daraja (not the passkey)
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey
# CustomerPayBillOnline for paybill, CustomerBuyGoodsOnline for till
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Till number when using CustomerBuyGoodsOnline. Defaults to MPESA_SHORTCODE.
MPESA_PARTY_B=
# Public https URL Safaricom can call. Localhost will not receive the callback.
MPESA_CALLBACK_URL=https://your-public-host/api/mpesa/callback

# ── Advanta SMS (optional) ────────────────────────────────────────────────────
ADVANTA_SMS_URL="https://quicksms.advantasms.com/api/services/sendsms/"
ADVANTA_API_KEY=your_api_key
ADVANTA_PARTNER_ID=your_partner_id
ADVANTA_SHORTCODE=your_shortcode_or_sender_id
