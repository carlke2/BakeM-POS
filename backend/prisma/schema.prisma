// Slow Rise Co — Bakery POS schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Staff users: owner (full access) | cashier (POS + attendance)
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  role      String // owner | cashier
  status    String   @default("active") // active | inactive
  password  String

  attendanceRecords StaffAttendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model StaffAttendance {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // check_in | check_out
  source    String   @default("manual")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("staff_attendance")
}

model MenuCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("menu_categories")
}

model MenuItem {
  id              String  @id @default(cuid())
  name            String
  description     String?
  price           Float   @default(0)
  category        String // matches MenuCategory.name
  imageUrl        String?
  isAvailable     Boolean @default(true)
  stockLevel      Int? // null = unlimited; when set, decrements on each sale
  batchYield      Int?    @map("batch_yield") // portions produced per recipe batch
  unitType        String  @default("piece") // piece | loaf | kg | dozen
  bestBeforeHours Int? // hours after production batch before flagged stale

  receiptItems      PosTransactionItem[]
  ingredients       MenuItemIngredient[]
  productionBatches ProductionBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("menu_items")
}

model ProductionBatch {
  id              String   @id @default(cuid())
  menuItemId      String   @map("menu_item_id")
  menuItem        MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  yieldQuantity   Int      @map("yield_quantity")
  unitPrice       Float    @map("unit_price")
  expectedRevenue Float    @map("expected_revenue")
  soldQuantity    Int      @default(0) @map("sold_quantity")
  soldAmount      Float    @default(0) @map("sold_amount")
  status          String   @default("active") // active | depleted
  notes           String?
  userId          String   @map("user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([menuItemId, status, createdAt])
  @@map("production_batches")
}

model MenuItemIngredient {
  id              String        @id @default(cuid())
  menuItemId      String
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantity        Float

  @@unique([menuItemId, inventoryItemId])
  @@map("menu_item_ingredients")
}

model PosTransaction {
  id            String  @id @default(cuid())
  receiptNo     String? @unique
  cashierId     String
  totalAmount   Float
  status        String  @default("completed") // completed, voided
  paymentMethod String  @default("cash") @map("payment_method") // cash | mpesa

  items PosTransactionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pos_transactions")
}

model PosTransactionItem {
  id            String         @id @default(cuid())
  transactionId String
  transaction   PosTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  menuItemId    String
  menuItem      MenuItem       @relation(fields: [menuItemId], references: [id])
  quantity      Int
  price         Float // Price at the time of purchase

  @@map("pos_transaction_items")
}

model Supplier {
  id            String  @id @default(cuid())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?

  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("suppliers")
}

model InventoryItem {
  id           String @id @default(cuid())
  name         String
  category     String // Dry goods, Dairy, Packaging, etc.
  unit         String // kg, liters, pieces
  stockLevel   Float  @default(0)
  reorderLevel Float  @default(0)
  unitCost     Float  @default(0)

  movements       StockMovement[]
  menuIngredients MenuItemIngredient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("inventory_items")
}

model StockMovement {
  id              String        @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  type            String // "IN", "OUT"
  quantity        Float
  reason          String // "purchase", "usage", "spoilage"
  supplierId      String?
  supplier        Supplier?     @relation(fields: [supplierId], references: [id])
  reference       String? // Invoice number
  notes           String?
  userId          String // User who recorded it
  createdAt       DateTime      @default(now())

  @@map("stock_movements")
}

model Expense {
  id          String   @id @default(cuid())
  category    String // Salaries, Utilities, Maintenance, Ingredients
  amount      Float
  description String
  date        DateTime @default(now())
  recordedBy  String // User ID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("expenses")
}

model AuditEvent {
  id          String   @id @default(cuid())
  eventType   String
  userType    String
  userId      String?
  userName    String
  userEmail   String?
  action      String
  description String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@map("audit_events")
}

// M-Pesa / KopoKopo till payments for POS sales only
model KopoPayment {
  id                   String   @id @default(cuid())
  reference            String?  @unique
  location             String?  @unique
  status               String   @default("pending")
  eventType            String   @default("buygoods_transaction_received") @map("event_type")
  amount               Float    @default(0)
  currency             String   @default("KES")
  phone                String   @default("")
  description          String   @default("")
  tillNumber           String   @default("") @map("till_number")
  transactionReference String   @default("") @map("transaction_reference")
  originationTime      String?  @map("origination_time")
  rawPayload           Json?    @map("raw_payload")
  purpose              String   @default("pos_sale") // pos_sale only
  posCart              Json?    @map("pos_cart")
  posCompleted         Boolean  @default(false) @map("pos_completed")
  posTransactionId     String?  @unique @map("pos_transaction_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("kopo_payments")
}
